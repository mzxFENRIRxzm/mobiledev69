DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Local rollout; keep false in production until SMTP and shared cache are configured.
PUBLIC_SIGNUP_ENABLED=true
# Temporary tunnel demos only. Keep false when real email delivery is configured.
DEMO_EMAIL_VERIFICATION_LINK=false
TRUST_PROXY_HEADERS=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=THE_X <noreply@localhost>
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600
# For production, configure an SMTP backend and set these through server secrets:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
GEOCODING_REVERSE_URL=https://photon.komoot.io/reverse
GEOCODING_FORWARD_URL=https://photon.komoot.io/api
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
DEMO_PASSWORD=
MECHANIC_DEMO_PASSWORD=
OIDC_SITE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:50000
