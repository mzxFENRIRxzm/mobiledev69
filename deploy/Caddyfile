{$SITE_ADDRESS} {
	encode zstd gzip

	@django path /api/* /openid/* /accounts/* /admin/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		root * /srv/flutter
		try_files {path} /index.html
		file_server
	}
}
