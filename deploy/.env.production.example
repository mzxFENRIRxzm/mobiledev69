# Replace the domain and secrets before exposing ports 80/443.
APP_ORIGIN=https://app.example.com
APP_HOST=app.example.com
SITE_ADDRESS=app.example.com
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
DJANGO_SECRET_KEY=__GENERATE_DJANGO_SECRET_KEY__
DJANGO_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600
PUBLIC_SIGNUP_ENABLED=false
DEMO_EMAIL_VERIFICATION_LINK=false
LOCAL_USERNAME_RESET_ENABLED=false
AI_CHAT_WEBHOOK_URL=
AI_CHAT_WEBHOOK_TOKEN=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@app.example.com
