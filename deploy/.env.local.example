# Local Docker demo. Bound to 127.0.0.1; verification links appear on screen.
APP_ORIGIN=http://localhost:18080
APP_HOST=localhost
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1:18080
HTTPS_BIND=127.0.0.1:18443
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
DJANGO_SECRET_KEY=__GENERATE_DJANGO_SECRET_KEY__
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
PUBLIC_SIGNUP_ENABLED=true
DEMO_EMAIL_VERIFICATION_LINK=true
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@localhost
